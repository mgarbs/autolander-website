# Preview build for preview.autolander.ai (vite build --mode preview).
# Tracking is OFF here so internal review traffic never pollutes live Meta
# attribution, and the build is marked noindex. Booking/chat still work via the
# shared Worker URL below.
VITE_DEPLOY_TARGET=preview
VITE_CHAT_API_URL=https://autolander-chatbot.michaelegarber.workers.dev
VITE_CAPI_URL=https://autolander-chatbot.michaelegarber.workers.dev
# VITE_META_PIXEL_ID intentionally unset — no Meta Pixel on the preview.
