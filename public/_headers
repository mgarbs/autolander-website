/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin*
  X-Robots-Tag: noindex, nofollow, noarchive

/pay*
  X-Robots-Tag: noindex, nofollow, noarchive

/r/*
  X-Robots-Tag: noindex, nofollow, noarchive

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/preview/*
  Cache-Control: public, max-age=2592000

/autolander-logo.png
  Cache-Control: public, max-age=604800

/autolander-logo-200.webp
  Cache-Control: public, max-age=31536000, immutable

/autolander-logo-240.webp
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/marketplace-video-poster.webp
  Cache-Control: public, max-age=604800

/marketplace-video-example.mp4
  Cache-Control: public, max-age=604800
  Accept-Ranges: bytes

/og-image.jpg
  Cache-Control: public, max-age=86400

/privacy.html
  Cache-Control: public, max-age=0, must-revalidate

/terms.html
  Cache-Control: public, max-age=0, must-revalidate

/thank-you.html
  Cache-Control: public, max-age=0, must-revalidate

/thank-you
  Cache-Control: public, max-age=0, must-revalidate

# Machine-readable twins for AI crawlers. Correct content-type matters: served as
# application/octet-stream a crawler downloads the file instead of reading it.
/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/data/*.csv
  Content-Type: text/csv; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/data/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
